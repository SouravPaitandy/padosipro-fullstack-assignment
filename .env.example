# ─── API server (this is a demo env file , copy this to apps/api/.env) ────────────────────────────
# Mobile env vars are in apps/mobile/.env.example to keep them separate.

# API server port
API_PORT=3000

# Proxy Trust Configuration
# Set to false (default) for direct/local use.
# ONLY enable this (e.g. "1" for one hop, or specific IP/subnet) if the server is
# behind a known trusted proxy (like an AWS ALB, Nginx, or Kubernetes Ingress)
# AND that proxy is properly configured to sanitize X-Forwarded-For headers.
TRUST_PROXY=false

# PostgreSQL connection string (matches docker-compose defaults)
DATABASE_URL=postgresql://padosipro:padosipro@localhost:5432/padosipro

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret

# HMAC-SHA-256 secret used for OTP digests — generate separately from JWT_SECRET
OTP_HMAC_SECRET=replace-with-a-different-strong-random-secret

# SMTP settings (Mailpit local dev defaults)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@padosipro.local
# Set to true to enforce TLS from start (e.g. port 465)
# SMTP_SECURE=false
# Set to true to disable STARTTLS upgrade (required for Mailpit local dev)
# SMTP_IGNORE_TLS=true
